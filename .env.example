# OpenRouter key used by api/score.js to embed the word. Set this in Vercel → Project → Settings → Environment Variables.
OPENROUTER_API_KEY=
# Neon Postgres connection string (Vercel sets this when you add a Neon database).
DATABASE_URL=
# Long random strings: the admin page token, and the secret Vercel Cron sends to /api/recompute.
ADMIN_TOKEN=
CRON_SECRET=
